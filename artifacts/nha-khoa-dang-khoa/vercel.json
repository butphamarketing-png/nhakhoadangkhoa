{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && corepack enable && pnpm install",
  "buildCommand": "cd ../.. && pnpm run build:deploy",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    { "source": "/adminbp", "destination": "/adminbp/index.html" },
    { "source": "/adminbp/", "destination": "/adminbp/index.html" },
    { "source": "/adminbp/:path*", "destination": "/adminbp/index.html" },
    { "source": "/((?!assets/|adminbp/).*)", "destination": "/index.html" }
  ]
}
