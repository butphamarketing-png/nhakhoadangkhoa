{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "corepack enable && pnpm install && pnpm run build:deploy",
  "outputDirectory": "artifacts/nha-khoa-dang-khoa/dist/public",
  "framework": "vite",
  "rewrites": [
    { "source": "/adminbp", "destination": "/adminbp/index.html" },
    { "source": "/adminbp/", "destination": "/adminbp/index.html" },
    { "source": "/adminbp/:path*", "destination": "/adminbp/index.html" },
    { "source": "/((?!assets/|adminbp/).*)", "destination": "/index.html" }
  ]
}
