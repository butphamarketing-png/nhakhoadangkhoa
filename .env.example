# =============================================================================
# SUPABASE (PostgreSQL) — dùng cho API + lệnh pnpm run db:push
# Supabase → Project Settings → Database → Connection string → URI
# Chọn "Transaction pooler" port 6543 (bắt buộc khi API chạy trên Vercel)
# =============================================================================
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# =============================================================================
# VERCEL — Project API (artifacts/api-server)
# =============================================================================
CORS_ORIGIN=https://nhakhoadangkhoa.vercel.app,https://ten-admin.vercel.app

# Đăng nhập admin panel (đặt mật khẩu mạnh trên production)
ADMIN_PASSWORD=dat-mat-khau-admin-manh
ADMIN_API_KEY=tao-chuoi-ngau-nhien-dai-32-ky-tu

# =============================================================================
# VERCEL — Project Website (artifacts/nha-khoa-dang-khoa)
# URL API sau khi deploy api-server (không có / ở cuối)
# =============================================================================
VITE_API_URL=https://nha-khoa-api.vercel.app

# =============================================================================
# VERCEL — Project Admin (artifacts/admin-panel)
# =============================================================================
# VITE_API_URL= (giống website — trỏ tới API)

# Chạy API local
PORT=5000
BASE_PATH=/
