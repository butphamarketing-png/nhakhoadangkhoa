# Supabase → Project Settings → Database → Connection string (URI)
# Dùng "Transaction pooler" (port 6543) khi deploy API lên Vercel
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# URL API (sau khi deploy api-server lên Vercel)
# Ví dụ: https://nha-khoa-api.vercel.app
VITE_API_URL=https://your-api.vercel.app

# CORS: domain website + admin (phân tách bằng dấu phẩy)
CORS_ORIGIN=https://your-site.vercel.app,https://your-admin.vercel.app

# Chỉ cần khi chạy api-server local (dev)
PORT=5000
